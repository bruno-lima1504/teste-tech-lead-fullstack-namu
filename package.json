{
  "name": "namu-sessoes",
  "private": true,
  "description": "Agendamento de sessões com especialistas de bem-estar (teste técnico Namu)",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "services:up": "docker compose -f infra/docker-compose.yml up -d",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
