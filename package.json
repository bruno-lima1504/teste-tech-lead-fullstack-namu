{
  "name": "namu-sessoes",
  "private": true,
  "description": "Agendamento de sessões com especialistas de bem-estar (teste técnico Namu)",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "services:up": "docker compose -f infra/docker-compose.yml up -d",
    "lint": "turbo run lint",
    "lint:structure": "node scripts/validate-structure.mjs",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f infra/docker-compose.yml up --build -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
